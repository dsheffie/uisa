+/* Opcode histogram for micro-engine studies. Set PREVIOUS_OPHIST=<file> to
+ * enable; counts are split by the supervisor bit and written at exit, or on
+ * SIGUSR1 (the snapshot is taken between instructions, on the CPU thread).
+ * Output: one line per executed opword, "opword user_count super_count". */
+static uae_u64 ophist[2][65536];
+static const char *ophist_path;
+static volatile sig_atomic_t ophist_dump_req;
+
+/* Optional exact per-PC counts: set PREVIOUS_PCHIST=<file>. Keyed by
+ * (pc, supervisor bit, opword), because user processes share virtual
+ * addresses. Output: "pc s opword count" per key. Open addressing; once the
+ * table is 3/4 full, new keys are dropped and counted in the header. */
+#define PCHIST_BITS 22
+static uae_u64 *pchist_key, *pchist_cnt;
+static uae_u64 pchist_used, pchist_dropped;
+static const char *pchist_path;
+
+static void pchist_add (uae_u32 pc, int s, uae_u32 opcode)
+{
+	uae_u64 key = ((uae_u64)pc << 17) | ((uae_u64)s << 16) | (opcode & 0xffff) | (1ull << 63);
+	uae_u64 mask = (1ull << PCHIST_BITS) - 1;
+	uae_u64 h = (key * 0x9e3779b97f4a7c15ull) >> (64 - PCHIST_BITS);
+	for (;;) {
+		if (pchist_key[h] == key) {
+			pchist_cnt[h]++;
+			return;
+		}
+		if (pchist_key[h] == 0) {
+			if (pchist_used >= (mask + 1) / 4 * 3) {
+				pchist_dropped++;
+				return;
+			}
+			pchist_key[h] = key;
+			pchist_cnt[h] = 1;
+			pchist_used++;
+			return;
+		}
+		h = (h + 1) & mask;
+	}
+}
+
+static void pchist_dump (void)
+{
+	FILE *f;
+	if (!pchist_path || !(f = fopen (pchist_path, "w")))
+		return;
+	fprintf (f, "# pc s opword count; keys %" PRIu64 " dropped %" PRIu64 "\n", pchist_used, pchist_dropped);
+	for (uae_u64 i = 0; i < (1ull << PCHIST_BITS); i++) {
+		uae_u64 k = pchist_key[i];
+		if (k)
+			fprintf (f, "%08x %d %04x %" PRIu64 "\n", (uae_u32)((k >> 17) & 0xffffffff),
+			         (int)((k >> 16) & 1), (uae_u32)(k & 0xffff), pchist_cnt[i]);
+	}
+	fclose (f);
+}
+
+static void ophist_dump (void)
+{
+	FILE *f;
+	ophist_dump_req = 0;
+	pchist_dump ();
+	if (!ophist_path || !(f = fopen (ophist_path, "w")))
+		return;
+	fprintf (f, "# opword user super\n");
+	for (int i = 0; i < 65536; i++) {
+		if (ophist[0][i] | ophist[1][i])
+			fprintf (f, "%04x %" PRIu64 " %" PRIu64 "\n", i, ophist[0][i], ophist[1][i]);
+	}
+	fclose (f);
+}
+
+static void ophist_sigusr1 (int sig)
+{
+	(void)sig;
+	ophist_dump_req = 1;
+}
+
+static void ophist_init (void)
+{
+	static bool done;
+	if (done)
+		return;
+	done = true;
+	ophist_path = getenv ("PREVIOUS_OPHIST");
+	pchist_path = getenv ("PREVIOUS_PCHIST");
+	if (pchist_path && !ophist_path)
+		ophist_path = "/dev/null";
+	if (!ophist_path)
+		return;
+	if (pchist_path) {
+		pchist_key = calloc (1ull << PCHIST_BITS, sizeof (uae_u64));
+		pchist_cnt = calloc (1ull << PCHIST_BITS, sizeof (uae_u64));
+		if (!pchist_key || !pchist_cnt)
+			pchist_path = NULL;
+	}
+	atexit (ophist_dump);
+	signal (SIGUSR1, ophist_sigusr1);
+}
+
 STATIC_INLINE void count_instr (uae_u32 opcode)
 {
+	if (!ophist_path)
+		return;
+	ophist[regs.s ? 1 : 0][opcode & 0xffff]++;
+	if (pchist_path)
+		pchist_add (m68k_getpc (), regs.s ? 1 : 0, opcode);
+	if (ophist_dump_req)
+		ophist_dump ();
 }
 
 static uae_u32 opcode_swap(uae_u16 opcode)
@@ -2407,6 +2514,7 @@ void check_prefs_changed_cpu(void)
 
 void init_m68k (void)
 {
+	ophist_init();
 	disasm_init();
 	prefs_changed_cpu ();
 	update_68k_cycles ();
