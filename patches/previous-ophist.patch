+/* Opcode histogram for micro-engine studies. Set PREVIOUS_OPHIST=<file> to
+ * enable; counts are split by the supervisor bit and written at exit, or on
+ * SIGUSR1 (the snapshot is taken between instructions, on the CPU thread).
+ * Output: one line per executed opword, "opword user_count super_count". */
+static uae_u64 ophist[2][65536];
+static const char *ophist_path;
+static volatile sig_atomic_t ophist_dump_req;
+
+static void ophist_dump (void)
+{
+	FILE *f;
+	ophist_dump_req = 0;
+	if (!ophist_path || !(f = fopen (ophist_path, "w")))
+		return;
+	fprintf (f, "# opword user super\n");
+	for (int i = 0; i < 65536; i++) {
+		if (ophist[0][i] | ophist[1][i])
+			fprintf (f, "%04x %" PRIu64 " %" PRIu64 "\n", i, ophist[0][i], ophist[1][i]);
+	}
+	fclose (f);
+}
+
+static void ophist_sigusr1 (int sig)
+{
+	(void)sig;
+	ophist_dump_req = 1;
+}
+
+static void ophist_init (void)
+{
+	static bool done;
+	if (done)
+		return;
+	done = true;
+	ophist_path = getenv ("PREVIOUS_OPHIST");
+	if (!ophist_path)
+		return;
+	atexit (ophist_dump);
+	signal (SIGUSR1, ophist_sigusr1);
+}
+
 STATIC_INLINE void count_instr (uae_u32 opcode)
 {
+	if (!ophist_path)
+		return;
+	ophist[regs.s ? 1 : 0][opcode & 0xffff]++;
+	if (ophist_dump_req)
+		ophist_dump ();
 }
 
 static uae_u32 opcode_swap(uae_u16 opcode)
@@ -2407,6 +2454,7 @@ void check_prefs_changed_cpu(void)
 
 void init_m68k (void)
 {
+	ophist_init();
 	disasm_init();
